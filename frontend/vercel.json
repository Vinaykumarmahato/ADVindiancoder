{
  "rewrites": [
    {
      "source": "/u/:username",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|googlebot|bingbot).*"
        }
      ],
      "destination": "/api/profile-og?username=:username"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}